{
  "name": "smoltalk",
  "version": "0.3.1",
  "description": "A common interface for LLM APIs",
  "homepage": "https://github.com/egonSchiele/smoltalk",
  "scripts": {
    "test": "vitest --exclude=**/*.live.test.ts",
    "test:live": "vitest run lib/clients/*.live.test.ts lib/embed/*.live.test.ts lib/image/*.live.test.ts",
    "test:tsc": "tsc -p tests/tsconfig.json",
    "build": "rm -rf dist && tsc",
    "start": "cd dist && node index.js",
    "doc": "typedoc --disableSources --out docs lib && prettier docs/ --write",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "./dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.js"
    }
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "keywords": [
    "smoltalk",
    "llm",
    "api"
  ],
  "author": "Aditya Bhargava",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/genai": "^1.34.0",
    "nanoid": "^5.1.6",
    "ollama": "^0.6.3",
    "openai": "^6.15.0",
    "zod": "^4.3.6"
  }
}
